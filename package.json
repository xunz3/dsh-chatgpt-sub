{
  "name": "@xunz03/dsh-chatgpt-sub",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Sign in with ChatGPT and use your plan in DeepSeek Harness",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.12.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "exports": {
    ".": {
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host/index.js"
    },
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "locale/*.json",
    "icon.svg",
    "assets/logo.svg",
    "assets/README.md",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:browser": "playwright test",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "prepack": "pnpm build",
    "check:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "jose": "6.2.13",
    "openai": "6.49.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-attachment": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-fs": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-typert-registry": ">=0.2.1-rc.2 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.3",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-settings-models": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.3",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.3",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xunz3/dsh-chatgpt-sub.git"
  },
  "homepage": "https://github.com/xunz3/dsh-chatgpt-sub#readme",
  "bugs": {
    "url": "https://github.com/xunz3/dsh-chatgpt-sub/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
